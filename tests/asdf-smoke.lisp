;; Integration test: run outside ASDF:TEST-OP (do not nest ASDF:OPERATE).
(require :asdf)
(asdf:load-asd (merge-pathnames "../sprolog.asd" *load-truename*))
(asdf:load-asd (merge-pathnames "sprolog-fixture.asd" *load-truename*))

(let ((sprolog:*database* (sprolog:make-database)))
  (let* ((component (asdf:find-component "sprolog-fixture" '("fixtures/relations")))
         (path (asdf:component-pathname component)))
    (assert (typep component 'asdf::prolog))
    (assert (string= "pl" (pathname-type path))))
  (asdf:compile-system "sprolog-fixture")
  (assert (null (gethash (cons 'pl_parent 2)
                         (sprolog::database-predicates sprolog:*database*))))
  (asdf:load-system "sprolog-fixture")
  (flet ((verify ()
           (assert (equal '(bob charlie)
                          (mapcar (lambda (bindings) (cdr (assoc '?who bindings)))
                                  (sprolog:query '((pl_ancestor alice ?who))))))
           (assert (= 2 (length (sprolog:query '((pl_parent ?x ?y))))))))
    (verify)
    (asdf:load-system "sprolog-fixture")
    (verify)
    (asdf:load-system "sprolog-fixture" :force t)
    (verify)))
(format t "ASDF :prolog smoke test passed.~%")
