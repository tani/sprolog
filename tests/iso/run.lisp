;;; ISO-oriented compatibility probes, through the conventional .pl interface.
;;; No Logtalk runtime, Quicklisp dependency, or imported upstream test code.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog")

(defpackage #:sprolog/iso-benchmark (:use #:cl))
(defpackage #:sprolog/iso-runner (:use #:cl))
(in-package #:sprolog/iso-runner)

(defparameter *root* (uiop:pathname-directory-pathname *load-truename*))
(defparameter *program* (merge-pathnames "core.pl" *root*))
(defparameter *manifest* (merge-pathnames "cases.sexp" *root*))
(defparameter *target-package* (find-package :sprolog/iso-benchmark))
(defparameter *statuses* '(:pass :fail :error :unsupported))
(defparameter *groups* '("syntax" "unification" "control" "clauses"
                          "arithmetic" "types" "exceptions" "dcg" "io"))

(defun expect-type (value type id field)
  (unless (typep value type)
    (error "Invalid ~A in ISO case ~A: ~S" field id value))
  value)

(defun valid-expect-p (expected)
  (or (member expected '(:success :failure :unsupported))
      (and (consp expected) (= (length expected) 2)
           (or (and (eq (first expected) :count)
                    (integerp (second expected))
                    (<= 0 (second expected) 1000))
               (and (eq (first expected) :error)
                    (stringp (second expected)))))))

(defun read-cases ()
  (let ((*read-eval* nil) (seen (make-hash-table :test 'equal)))
    (with-open-file (in *manifest*)
      (let ((cases (read in nil :eof)))
        (unless (and (listp cases) (not (eq cases :eof)))
          (error "ISO case manifest must be a list"))
        (unless (eq (read in nil :eof) :eof)
          (error "Unexpected second form in ISO case manifest"))
        (dolist (case cases)
          (unless (and (listp case) (evenp (length case)))
            (error "Malformed ISO case: ~S" case))
          (let ((id (getf case :id))
                (area (getf case :area))
                (goal (getf case :goal))
                (expected (getf case :expect)))
            (expect-type id 'string "?" :id)
            (expect-type area 'string id :area)
            (expect-type goal 'string id :goal)
            (unless (member area *groups* :test #'equal)
              (error "Unknown ISO area in ~A: ~A" id area))
            (unless (valid-expect-p expected)
              (error "Invalid expectation in ~A: ~S" id expected))
            (when (and (getf case :upstream)
                       (not (stringp (getf case :upstream))))
              (error "Invalid upstream reference in ~A" id))
            (when (gethash id seen)
              (error "Duplicate ISO case id: ~A" id))
            (setf (gethash id seen) t)
            (when (and (eq expected :unsupported)
                       (not (and (stringp (getf case :reason))
                                 (plusp (length (getf case :reason))))))
              (error "UNSUPPORTED case ~A must state a reason" id))
            (when (and (getf case :required) (eq expected :unsupported))
              (error "Required case ~A cannot be unsupported" id))))
        (unless cases (error "Empty ISO compatibility manifest"))
        cases))))

(defun exception-class (condition)
  (let* ((term (sprolog:iso-exception-term condition))
         (description (and (consp term) (second term)))
         (name (if (consp description) (car description) description)))
    (if (symbolp name)
        (string-downcase (symbol-name name))
        (princ-to-string name))))

(defun execute-case (case)
  "Return STATUS, ACTUAL, DETAIL. Database is isolated for every case."
  (let ((expected (getf case :expect)))
    (when (eq expected :unsupported)
      (return-from execute-case
        (values :unsupported "not executed" (getf case :reason))))
    (let ((sprolog:*database* (sprolog:make-database)))
      (handler-case
          (let ((count
                  (flet ((run ()
                           (sprolog:load-prolog *program*
                             :package *target-package* :database sprolog:*database*)
                           (let* ((goal (sprolog:parse-prolog-goal
                                          (getf case :goal) :package *target-package*))
                                  (limit (if (and (consp expected)
                                                  (eq (first expected) :count))
                                             (1+ (second expected)) 1)))
                             (length (sprolog:query (list goal)
                                       :database sprolog:*database*
                                       :limit limit)))))
                    #+sbcl (sb-ext:with-timeout 5 (run))
                    #-sbcl (run))))
            (cond
              ((and (eq expected :success) (plusp count))
               (values :pass (format nil "~D solution(s), truncated at 1" count) ""))
              ((and (eq expected :failure) (zerop count))
               (values :pass "0 solutions" ""))
              ((and (consp expected) (eq (car expected) :count)
                    (= count (second expected)))
               (values :pass (format nil "~D solutions" count) ""))
              (t (values :fail (format nil "~D solution(s)" count)
                         (format nil "Expected ~S" expected)))))
        (sprolog:iso-exception (condition)
          (let ((actual (exception-class condition)))
            (if (and (consp expected) (eq (car expected) :error)
                     (string= actual (second expected)))
                (values :pass (format nil "Prolog exception: ~A" actual) "")
                (values :fail (format nil "Prolog exception: ~A" actual)
                        (format nil "Expected ~S" expected)))))
        #+sbcl (sb-ext:timeout (condition)
                 (declare (ignore condition))
                 (values :error "time limit" "Prolog probe exceeded five seconds"))
        (error (condition)
          (values :error (format nil "~A" (type-of condition))
                  (princ-to-string condition)))))))

(defun quote-json (value stream)
  (write-char #\" stream)
  (loop for char across (princ-to-string value) do
    (case char
      (#\" (write-string "\\\"" stream))
      (#\\ (write-string "\\\\" stream))
      (#\Newline (write-string "\\n" stream))
      (#\Return (write-string "\\r" stream))
      (#\Tab (write-string "\\t" stream))
      (otherwise
        (if (< (char-code char) 32)
            (format stream "\\u~4,'0X" (char-code char))
            (write-char char stream)))))
  (write-char #\" stream))

(defun json-field (key value stream &optional comma)
  (when comma (write-char #\, stream))
  (quote-json key stream)
  (write-char #\: stream)
  (quote-json value stream))

(defun count-status (results status &optional area)
  (count-if (lambda (result)
              (and (eq (getf result :status) status)
                   (or (null area) (equal area (getf result :area)))))
            results))

(defun json-report (results pathname)
  (with-open-file (out pathname :direction :output :if-exists :supersede)
    (write-string "{" out)
    (json-field "suite" "sprolog native .pl compatibility probes" out)
    (json-field "source" "tests/iso/cases.sexp" out t)
    (json-field "revision" (or (uiop:getenv "GITHUB_SHA") "local") out t)
    (format out ",~%\"summary\":{")
    (format out "\"total\":~D,\"attempted\":~D,\"pass\":~D,\"fail\":~D,\"error\":~D,\"unsupported\":~D},~%"
            (length results)
            (- (length results) (count-status results :unsupported))
            (count-status results :pass)
            (count-status results :fail)
            (count-status results :error)
            (count-status results :unsupported))
    (write-string "\"results\":[" out)
    (loop for result in results for first = t then nil do
      (unless first (write-char #\, out))
      (write-string (format nil "~%{") out)
      (loop for (key json-key) on '( :id "id" :area "area" :goal "goal" :upstream "upstream"
                                    :expected "expected" :status "status"
                                    :actual "actual" :detail "detail"
                                    :required "required") by #'cddr
            for initial = t then nil do
               (json-field json-key (getf result key) out (not initial)))
      (write-char #\} out))
    (write-string (format nil "~%]}~%") out)))

(defun markdown-report (results pathname)
  (with-open-file (out pathname :direction :output :if-exists :supersede)
    (let* ((attempted (- (length results) (count-status results :unsupported)))
           (passed (count-status results :pass)))
      (format out "# Prolog interface compatibility report~%~%")
      (format out "This measures ~D locally maintained probes through sprolog's conventional .pl reader and WAM runtime, **not** the complete ISO/IEC 13211-1 conformance suite.~%~%"
              (length results))
      (format out "Exercised: **~D/~D passed (~,1F%%)**. Unsupported: **~D** (excluded from the exercised denominator).~%~%"
              passed attempted (if (plusp attempted) (* 100.0 (/ passed attempted)) 0.0)
              (count-status results :unsupported))
      (format out "Source-equivalent adaptations of ISO-prefixed Logtalk test IDs: **~D** (the native Logtalk runner is not used).~%~%"
              (count-if (lambda (x) (plusp (length (getf x :upstream)))) results))
      (format out "| Area | PASS | FAIL | ERROR | UNSUPPORTED |~%|---|---:|---:|---:|---:|~%")
      (dolist (area *groups*)
        (when (find area results :key (lambda (x) (getf x :area)) :test #'equal)
          (format out "| ~A | ~D | ~D | ~D | ~D |~%"
                  area (count-status results :pass area) (count-status results :fail area)
                  (count-status results :error area) (count-status results :unsupported area))))
      (format out "~%## Cases~%~%| ID | Status | Expected | Observed or reason | Upstream reference |~%|---|---|---|---|---|~%")
      (dolist (entry results)
        (flet ((safe (text)
                 (substitute #\/ #\| (substitute #\Space #\Newline (princ-to-string text)))))
          (format out "| ~A | ~A | ~A | ~A | ~A |~%"
                  (safe (getf entry :id)) (safe (getf entry :status))
                  (safe (getf entry :expected))
                  (safe (if (eq (getf entry :status) :unsupported)
                            (getf entry :detail)
                            (getf entry :actual)))
                  (safe (getf entry :upstream))))))))

(defun run-suite (&key (output #P"compat-results/") strict)
  (let ((results nil))
    (dolist (case (read-cases))
      (multiple-value-bind (status actual detail) (execute-case case)
        (let ((row (list :id (getf case :id) :area (getf case :area)
                         :goal (getf case :goal) :upstream (or (getf case :upstream) "")
                         :expected (prin1-to-string (getf case :expect))
                         :status status :actual actual :detail detail
                         :required (if (getf case :required) "true" "false"))))
          (push row results)
          (format t "~8A ~A~%" status (getf case :id)))))
    (setf results (nreverse results))
    (let ((directory (uiop:ensure-directory-pathname output)))
      (ensure-directories-exist (merge-pathnames "results.json" directory))
      (json-report results (merge-pathnames "results.json" directory))
      (markdown-report results (merge-pathnames "summary.md" directory)))
    (format t "~%PASS ~D  FAIL ~D  ERROR ~D  UNSUPPORTED ~D~%"
            (count-status results :pass) (count-status results :fail)
            (count-status results :error) (count-status results :unsupported))
    (when (and strict
               (some (lambda (result)
                       (and (string= (getf result :required) "true")
                            (not (eq (getf result :status) :pass))))
                     results))
      (error "A required compatibility probe regressed"))
    results))

(let ((args (uiop:command-line-arguments)) (output #P"compat-results/") (strict nil))
  (loop while args do
    (let ((arg (pop args)))
      (cond ((string= arg "--strict") (setf strict t))
            ((string= arg "--output")
             (unless args (error "--output requires a directory"))
             (setf output (pathname (pop args))))
            (t (error "Unknown option: ~A" arg)))))
  (run-suite :output output :strict strict))
