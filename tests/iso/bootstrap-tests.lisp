;;; Smoke/regression tests for the optional sprolog/iso interpreter.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog/iso")

(defpackage #:sprolog/iso/bootstrap-tests (:use #:cl))
(in-package #:sprolog/iso/bootstrap-tests)

(defvar *assertions* 0)
(defun verify (truth &optional (description "ISO bootstrap regression"))
  (incf *assertions*)
  (unless truth (error "FAILED: assertion ~D (~A)" *assertions* description)))
(defun errors-p (thunk &optional type)
  (handler-case (progn (funcall thunk) nil)
    (error (condition)
      (or (null type) (typep condition type)))))
(defun answer (name solution)
  (cdr (find name solution :key (lambda (pair) (symbol-name (car pair)))
             :test #'string=)))

(defun run-tests ()
  (let* ((program (merge-pathnames "bootstrap.pl" *load-truename*))
         (runtime (sprolog/iso:make-runtime))
         (fresh (sprolog/iso:make-runtime)))
    (verify (eq :iso-atom (car (sprolog/iso:parse-term "a."))))
    (verify (sprolog/iso:atom-p (sprolog/iso:parse-term "a")))
    (verify (sprolog/iso:compound-p (sprolog/iso:parse-term "f(a,b)")))
    (verify (string= "f" (sprolog/iso:term-functor
                            (sprolog/iso:parse-term "f(a,b)"))))
    (verify (= 2 (length (sprolog/iso:term-arguments
                            (sprolog/iso:parse-term "f(a,b)")))))
    (verify (not (equal (sprolog/iso:parse-term "f(a,b)")
                        (sprolog/iso:parse-term "[f,a,b]")))
            "Compound terms and lists must not have the same representation")
    (verify (not (equal (sprolog/iso:parse-term "[]")
                        (sprolog/iso:parse-term "nil")))
            "Empty-list atom is distinct from the atom nil")
    (verify (string= "[]" (sprolog/iso:term-functor
                            (sprolog/iso:parse-term "[]"))))
    (verify (string= "MiXeD" (sprolog/iso:term-functor
                                (sprolog/iso:parse-term "'MiXeD'"))))
    (verify (not (equal (sprolog/iso:parse-term "'MiXeD'")
                        (sprolog/iso:parse-term "mixed")))
            "ISO atoms are case-sensitive")
    (verify (sprolog/iso:atom-p (sprolog/iso:parse-term "'?Name'"))
            "Quoted atoms never become native logic variables")
    (verify (not (sprolog/iso:atom-p (sprolog/iso:parse-term "Name"))))
    (verify (not (eq (car (sprolog/iso:parse-term "pair(_,_)"))
                     :iso-atom)))
    (verify (errors-p (lambda () (sprolog/iso:parse-term "f()")))
            "Zero-arity compound syntax is not accepted")
    (verify (errors-p (lambda () (sprolog/iso:parse-term "1.5")))
            "No silent float misparse")
    (verify (errors-p (lambda () (sprolog/iso:parse-term "a b")))
            "Unexpected trailing tokens are rejected")
    (multiple-value-bind (same number)
        (sprolog/iso:consult program :runtime runtime)
      (verify (eq same runtime))
      (verify (= number 13)))
    (verify (handler-case
                (progn (sprolog/iso:query "parent(alice,bob)." :runtime fresh) nil)
              (sprolog:iso-exception () t))
            "Runtimes have independent clauses and missing names signal existence_error")
    (verify (= 2 (length (sprolog/iso:query "parent(X,Y)." :runtime runtime))))
    (let* ((answers (sprolog/iso:query "ancestor(alice,Who)." :runtime runtime))
           (names (mapcar (lambda (row)
                            (sprolog/iso:term-functor (answer "?Who" row))) answers)))
      (verify (equal names '("bob" "charlie"))
              "Native meta-interpreter evaluates left-recursive alternatives"))
    (verify (= 1 (length (sprolog/iso:query "parent(X,Y)." :runtime runtime :limit 1))))
    (verify (sprolog/iso:query "f(a,b) = f(a,b)." :runtime runtime))
    (verify (sprolog/iso:query "f(_,_) = f(a,b)." :runtime runtime)
            "Distinct anonymous variables")
    (verify (null (sprolog/iso:query "f(X,X) = f(a,b)." :runtime runtime))
            "Repeated named variables share identity")
    (verify (sprolog/iso:query "X = [a|Tail], Tail = [b], X = [a,b]."
                               :runtime runtime)
            "ISO list tails and variables retain sharing")
    (verify (null (sprolog/iso:query "f(a,b) = [f,a,b]." :runtime runtime))
            "Tagged ISO f/2 and ./2 lists cannot unify")
    (verify (null (sprolog/iso:query "[] = nil." :runtime runtime)))
    (verify (sprolog/iso:query "[a,b] = [a|[b]]." :runtime runtime))
    (verify (= 2 (length (sprolog/iso:query "choice(X)." :runtime runtime))))
    (verify (= 2 (length (sprolog/iso:query "alternative(X)." :runtime runtime))))
    (verify (sprolog/iso:query "mixed('MiXeD')." :runtime runtime))
    (verify (null (sprolog/iso:query "mixed(mixed)." :runtime runtime)))
    (verify (sprolog/iso:query "empty_list([])." :runtime runtime))
    (verify (null (sprolog/iso:query "empty_list(nil)." :runtime runtime)))
    (verify (errors-p (lambda () (sprolog/iso:query "!" :runtime runtime))
                      'sprolog/iso:unsupported-iso-goal))
    (verify (null (sprolog/iso:query "fail -> true" :runtime runtime))
            "Failed if-condition yields no answer")
    (verify (sprolog/iso:query "\\+ fail" :runtime runtime)
            "Negation succeeds for a defined failing predicate")
    ;; Reject unsupported program clauses before publishing earlier facts.
    (let ((tmp (make-pathname :name "bootstrap-bad" :type "pl"
                              :defaults (uiop:temporary-directory))))
      (unwind-protect
           (progn
             (with-open-file (out tmp :direction :output :if-exists :supersede)
               (write-line "new_fact(a)." out)
               (write-line "bad(X) :- call(!)." out))
             (verify (errors-p (lambda () (sprolog/iso:consult tmp :runtime runtime))
                               'sprolog/iso:unsupported-iso-goal))
             (verify (errors-p (lambda () (sprolog/iso:query "new_fact(a)." :runtime runtime))
                               'sprolog:iso-exception)
                     "Bad source is not partially loaded"))
        (when (probe-file tmp) (delete-file tmp))))
    ;; Native S-expression Prolog remains unmodified.
    (let ((sprolog:*database* (sprolog:make-database)))
      (sprolog:<-- (native-ok))
      (verify (sprolog:query '((native-ok)))))
    (format t "~D ISO bootstrap assertions passed.~%" *assertions*)
    t))
(run-tests)
