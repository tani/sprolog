;;; Differential tests for ISO call/N, closure extension, and variable aliasing.
(require :asdf)
(asdf:load-asd (merge-pathnames "../../sprolog.asd" *load-truename*))
(asdf:load-system "sprolog/iso")
(defpackage #:sprolog/iso/call-tests (:use #:cl))
(in-package #:sprolog/iso/call-tests)
(defvar *checks* 0)

(defun test (truth description)
  (incf *checks*)
  (unless truth (error "FAILED ~D: ~A" *checks* description)))

(defun values-for (db query name)
  (mapcar (lambda (answer)
            (let ((x (cdr (find name answer :key (lambda (v) (symbol-name (car v)))
                               :test #'string=))))
              (if (sprolog/iso:atom-p x) (sprolog/iso:term-functor x) x)))
          (sprolog/iso:query query :runtime db)))

(defun run ()
  (let ((db (sprolog/iso:make-runtime)))
    (sprolog/iso:consult (merge-pathnames "call-n.pl" *load-truename*) :runtime db)
    (test (equal (values-for db "call(unary,X)." "?X") '("a" "b"))
          "call/2 with atom closure enumerates both solutions")
    (test (equal (values-for db "call(binary(a),X)." "?X") '("b" "c"))
          "call/2 extends a compound closure")
    (test (sprolog/iso:query "call(binary,a,b)." :runtime db)
          "call/3 supports two added arguments")
    (test (sprolog/iso:query "call(ternary(a),b,c)." :runtime db)
          "call/3 extends an existing compound")
    (test (sprolog/iso:query "call(ternary,a,b,c)." :runtime db)
          "call/4 extends atom to a three-argument goal")
    (test (sprolog/iso:query "call(octary(a),b,c,d,e,f,g,h)." :runtime db)
          "call/8 supports seven extra arguments on a compound closure")
    (test (null (sprolog/iso:query "call(binary,b,a)." :runtime db))
          "call/N does not add extra solutions")
    (test (sprolog/iso:query "app_unary(a)." :runtime db)
          "call/2 inside source clause")
    (test (equal (values-for db "app_binary(a,Y)." "?Y") '("b" "c"))
          "call/3 inside source clause")
    (test (sprolog/iso:query "app_ternary(a,b,c)." :runtime db)
          "call/4 inside source clause")
    (test (sprolog/iso:query "app_octary(a,b,c,d,e,f,g,h)." :runtime db)
          "call/8 inside source clause")
    (test (equal (values-for db "part_binary(Y)." "?Y") '("b" "c"))
          "partial closure preserves backtracking")
    (test (sprolog/iso:query "part_ternary(c)." :runtime db)
          "closure preserves prefix arguments")
    (test (equal (values-for db "meta_twice(X)." "?X") '("a" "b"))
          "nested call as closure")
    (test (sprolog/iso:query "meta_direct(unary(a))." :runtime db)
          "a variable in the body denotes call/1 after instantiation")
    (test (handler-case (progn (sprolog/iso:query "meta_direct(P)." :runtime db) nil)
            (sprolog:iso-exception () t))
          "an unbound body-goal variable raises instantiation_error")
    (test (equal (values-for db "meta_equals(X)." "?X") '("a"))
          "call/3 can invoke builtin =/2")
    (test (equal (values-for db "meta_alias(X,Y), X = a." "?Y") '("a"))
          "unification through closure preserves shared variables")
    (test (equal (values-for db "call(=(X),a)." "?X") '("a"))
          "unification of extended compound propagates to outer variable")
    (test (equal (values-for db "P = unary, call(P,X)." "?X") '("a" "b"))
          "runtime-instantiated closure preserves the output logic variable")
    (test (equal (values-for db "P = binary(a), call(P,Y)." "?Y") '("b" "c"))
          "runtime-instantiated partial closure remains nondeterministic")
    (test (handler-case
              (progn (sprolog/iso:query "P = !, call(P)." :runtime db) nil)
            (sprolog/iso:unsupported-iso-goal () t))
          "dynamically constructed cut cannot silently become failure")
    (test (handler-case (progn (sprolog/iso:query "call(42,a)." :runtime db) nil)
            (sprolog:iso-exception () t))
          "noncallable closure raises Prolog type_error")
    (test (handler-case (progn (sprolog/iso:query "call(C,a)." :runtime db) nil)
            (sprolog:iso-exception () t))
          "unbound closure raises instantiation_error")
    (test (handler-case (progn (sprolog/iso:query "call(unknown_predicate,a)." :runtime db) nil)
            (sprolog:iso-exception () t))
          "undefined target raises existence_error")
    (format t "~D ISO call/N checks passed.~%" *checks*)))
(run)
