;; Conventional .pl syntax reader for the Lisp-native sprolog engine.
;; Only the documented syntax is accepted; there is no ISO module system.
(defpackage #:sprolog/src/prolog-loader (:use #:cl #:sprolog/src/builtins))
(in-package #:sprolog)

(defstruct (pl-reader (:constructor make-pl-reader (stream package)))
  stream package token)
(defstruct (pl-list (:constructor make-pl-list (value))) value)
(defun pl-peek-char (reader)
  (peek-char nil (pl-reader-stream reader) nil nil))
(defun pl-get-char (reader)
  (read-char (pl-reader-stream reader) nil nil))
(defun pl-error (reader control &rest args)
  (error "Invalid Prolog source at offset ~S: ~A"
         (file-position (pl-reader-stream reader))
         (apply #'format nil control args)))
(defun pl-word-char-p (character)
  (and character (or (alphanumericp character) (char= character #\_))))
(defun pl-operator-char-p (character)
  (and character (find character "!#$&*+-/:<=>?@\\^~" :test #'char=)))
(defun pl-quoted-token (reader quote)
  (with-output-to-string (out)
    (loop for character = (pl-get-char reader) do
      (unless character (pl-error reader "Unterminated quoted token"))
      (cond ((char= character quote)
             (if (eql (pl-peek-char reader) quote)
                 (progn (pl-get-char reader) (write-char character out))
                 (return)))
            ((char= character #\\)
             (let ((escaped (pl-get-char reader)))
               (unless escaped (pl-error reader "Unterminated quoted escape"))
               (write-char escaped out)))
            (t (write-char character out))))))
(defun pl-next-token (reader)
  (loop for character = (pl-peek-char reader) do
    (cond ((null character) (return-from pl-next-token (cons :eof "EOF")))
          ((find character '(#\Space #\Tab #\Newline #\Return #\Page))
           (pl-get-char reader))
          ((char= character #\%)
           (loop for c = (pl-get-char reader)
                 until (or (null c) (char= c #\Newline))))
          (t (return))))
  (let ((character (pl-get-char reader)))
    (cond
      ((pl-word-char-p character)
       (if (digit-char-p character)
           (cons :integer
                 (parse-integer (with-output-to-string (out)
                                  (write-char character out)
                                  (loop while (and (pl-peek-char reader)
                                                   (digit-char-p (pl-peek-char reader)))
                                        do (write-char (pl-get-char reader) out)))))
           (let ((word (with-output-to-string (out)
                         (write-char character out)
                         (loop while (pl-word-char-p (pl-peek-char reader))
                               do (write-char (pl-get-char reader) out)))))
             (cons (if (or (upper-case-p character) (char= character #\_))
                       :variable :atom) word))))
      ((char= character #\') (cons :atom (pl-quoted-token reader #\')))
      ((char= character #\") (cons :string (pl-quoted-token reader #\")))
      ((find character "()[]{},.|;" :test #'char=) (cons :punct (string character)))
      ((pl-operator-char-p character)
       (when (and (char= character #\/) (eql (pl-peek-char reader) #\*))
         (pl-get-char reader)
         (loop with previous = nil for c = (pl-get-char reader) do
           (unless c (pl-error reader "Unterminated block comment"))
           (when (and (eql previous #\*) (eql c #\/)) (return))
           (setf previous c))
         (return-from pl-next-token (pl-next-token reader)))
       (cons :operator
             (with-output-to-string (out)
               (write-char character out)
               (loop while (pl-operator-char-p (pl-peek-char reader))
                     do (write-char (pl-get-char reader) out)))))
      (t (pl-error reader "Unexpected character ~S" character)))))
(defun pl-peek (reader)
  (or (pl-reader-token reader)
      (setf (pl-reader-token reader) (pl-next-token reader))))
(defun pl-take (reader)
  (prog1 (pl-peek reader) (setf (pl-reader-token reader) nil)))
(defun pl-is (reader token)
  (equal (cdr (pl-peek reader)) token))
(defun pl-accept (reader token)
  (when (pl-is reader token) (pl-take reader) t))
(defun pl-expect (reader token)
  (unless (pl-accept reader token)
    (pl-error reader "Expected ~S; got ~S" token (cdr (pl-peek reader)))))
(defun pl-symbol (reader name)
  (intern (string-upcase name) (pl-reader-package reader)))
(defun pl-variable (reader name)
  (if (string= name "_") (make-symbol "?")
      (pl-symbol reader (concatenate 'string "?" name))))
(defun pl-binding (name)
  (cond ((string= name ";") 10)
        ((string= name "->") 12)
        ((string= name ",") 15)
        ((member name '("=" "\\=" "==" "\\==" "<" ">" "=<" ">="
                        "=:=" "=\\=" "is") :test #'string=) 30)
        ((member name '("+" "-") :test #'string=) 40)
        ((member name '("*" "/" "//" "mod" "rem") :test #'string=) 50)
        (t nil)))
(defun pl-arguments (reader)
  (let ((arguments nil))
    (unless (pl-is reader ")")
      (loop
        (push (pl-expression reader 16) arguments)
        (unless (pl-accept reader ",") (return))))
    (pl-expect reader ")")
    (nreverse arguments)))
(defun pl-list-expression (reader)
  (when (pl-accept reader "]")
    (return-from pl-list-expression (make-pl-list nil)))
  (let ((elements nil) (tail nil))
    (loop
      (push (pl-expression reader 16) elements)
      (cond ((pl-accept reader ","))
            ((pl-accept reader "|")
             (setf tail (pl-expression reader 16))
             (pl-expect reader "]")
             (return))
            (t (pl-expect reader "]") (return))))
    (make-pl-list (reduce #'cons (nreverse elements) :from-end t :initial-value tail))))
(defun pl-primary (reader)
  (let* ((token (pl-take reader)) (kind (car token)) (spelling (cdr token)))
    (cond
      ((or (eq kind :integer) (eq kind :string)) spelling)
      ((eq kind :variable) (pl-variable reader spelling))
      ((equal spelling "(")
       (prog1 (pl-expression reader 0) (pl-expect reader ")")))
      ((equal spelling "[") (pl-list-expression reader))
      ((and (eq kind :operator) (member spelling '("-" "+" "\\+") :test #'equal))
       (let ((operand (pl-expression reader 60)))
         (if (and (numberp operand) (string= spelling "-"))
             (- operand)
             (list (pl-symbol reader spelling) operand))))
      ((member kind '(:atom :operator))
       (let ((symbol (pl-symbol reader spelling)))
         (if (pl-accept reader "(")
             (cons symbol (pl-arguments reader))
             symbol)))
      (t (pl-error reader "Unexpected token ~S" token)))))
(defun pl-expression (reader &optional (minimum 0))
  (let ((left (pl-primary reader)))
    (loop
      (let* ((next (pl-peek reader))
             (name (cdr next))
             (binding (and (member (car next) '(:operator :punct :atom))
                           (pl-binding name))))
        (unless (and binding (>= binding minimum)) (return))
        (pl-take reader)
        (setf left (list (pl-symbol reader name) left
                         (pl-expression reader (1+ binding))))))
    left))
(defun pl-normalize (term)
  (cond ((pl-list-p term) (pl-normalize (pl-list-value term)))
        ((consp term) (cons (pl-normalize (car term))
                            (pl-normalize (cdr term))))
        (t term)))
(defun pl-dcg-body (term reader)
  (cond ((pl-list-p term)
         (let ((tokens (pl-normalize (pl-list-value term))))
           (unless (and (listp tokens) (sprolog::finite-list-p tokens))
             (pl-error reader "DCG terminal list must be proper: ~S" tokens))
           (cons :terminals tokens)))
        ((and (consp term) (symbolp (car term))
              (member (symbol-name (car term)) '("," ";") :test #'string=))
         (cons (pl-symbol reader (if (string= (symbol-name (car term)) ",") "and" "or"))
               (mapcar (lambda (child) (pl-dcg-body child reader)) (cdr term))))
        (t (pl-normalize term))))
(defun pl-head (term reader)
  (let ((normalized (pl-normalize term)))
    (cond ((and (consp normalized) (symbolp (car normalized))) normalized)
          ((symbolp normalized) (list normalized))
          (t (pl-error reader "Invalid predicate head: ~S" normalized)))))
(defun pl-declaration (reader)
  (pl-expect reader ":-")
  (let ((directive (pl-normalize (pl-expression reader 0))))
    (pl-expect reader ".")
    (unless (and (consp directive)
                 (symbolp (car directive))
                 (string= (symbol-name (car directive)) "TABLE")
                 (= (length directive) 2)
                 (consp (second directive))
                 (string= (symbol-name (car (second directive))) "/")
                 (= (length (second directive)) 3)
                 (symbolp (second (second directive)))
                 (integerp (third (second directive)))
                 (not (minusp (third (second directive)))))
      (pl-error reader "Unsupported directive: ~S" directive))
    (list :table (second (second directive)) (third (second directive)))))
(defun pl-clause (reader)
  (when (eq (car (pl-peek reader)) :eof)
    (return-from pl-clause :eof))
  (when (pl-is reader ":-")
    (return-from pl-clause (pl-declaration reader)))
  (let ((head (pl-head (pl-expression reader 16) reader)))
    (cond ((pl-accept reader ".") (list :fact head))
          ((pl-accept reader ":-")
           (let ((body (pl-normalize (pl-expression reader 0))))
             (pl-expect reader ".")
             (list :rule head body)))
          ((pl-accept reader "-->")
           (let ((body (pl-dcg-body (pl-expression reader 0) reader)))
             (pl-expect reader ".")
             (list :dcg head body)))
          (t (pl-error reader "Expected '.', ':-', or '-->' after ~S" head)))))
(defun read-prolog (pathname &key (package *package*))
  "Parse a restricted conventional Prolog .pl source without evaluating it."
  (let ((package (or (find-package package)
                     (error "Unknown Prolog package: ~S" package))))
    (with-open-file (stream pathname :direction :input)
      (let ((reader (make-pl-reader stream package)) (forms nil))
        (loop for form = (pl-clause reader) until (eq form :eof)
              do (push form forms))
        (nreverse forms)))))
(defun load-prolog (pathname &key (package *package*) (database *database*))
  "Read .pl clauses into DATABASE. First clause for each predicate replaces
its previous definition; later clauses append. Syntax errors leave DB untouched."
  (let ((forms (read-prolog pathname :package package))
        (seen (make-hash-table :test 'equal)))
    (dolist (form forms)
      (case (car form)
        (:table (table (second form) (third form) database))
        (otherwise
         (let ((head (second form)) (body (third form)))
           (when (eq (car form) :dcg)
             (multiple-value-setq (head body) (dcg-expand head (list body))))
           (let ((key (predicate-key head)))
             (add-clause head
                         (if (eq (car form) :dcg) body
                             (if (eq (car form) :fact) nil (list body)))
                         (not (gethash key seen)) database)
             (setf (gethash key seen) t))))))
    pathname))


(defun parse-prolog-goal (source &key (package *package*))
  "Read one conventional Prolog goal from SOURCE (a string). A final full
stop is optional. Symbols use PACKAGE; variables X map to Lisp ?X."
  (let ((package (or (find-package package)
                     (error "Unknown Prolog package: ~S" package))))
    (with-input-from-string (stream source)
      (let* ((reader (make-pl-reader stream package))
             (goal (pl-normalize (pl-expression reader 0))))
        (pl-accept reader ".")
        (unless (eq (car (pl-peek reader)) :eof)
          (pl-error reader "Unexpected token after goal: ~S"
                    (cdr (pl-peek reader))))
        (cond ((symbolp goal) (list goal))
              ((and (consp goal) (symbolp (car goal))) goal)
              (t (pl-error reader "Expected a callable goal: ~S" goal)))))))
